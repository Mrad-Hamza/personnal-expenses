datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  categories   Category[]
  products     Product[]
  purchases    Purchase[]
}

model Category {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  name     String
  products Product[]

  @@unique([userId, name])
}

model Product {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  name       String
  createdAt  DateTime   @default(now())
  purchases  Purchase[]

  @@index([userId, name])
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  price       Decimal  @db.Decimal(10, 2)
  purchasedAt DateTime @db.Date
  createdAt   DateTime @default(now())

  @@index([userId, purchasedAt])
}
